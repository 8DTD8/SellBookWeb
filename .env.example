# Sao chép thành .env trên VPS và điền giá trị thật.
# cp .env.example .env

# MongoDB (mặc định: container mongo trong docker-compose)
SPRING_DATA_MONGODB_URI=mongodb://mongo:27017/bookstore

# CORS — domain public (HTTPS) cách nhau bởi dấu phẩy, không có khoảng trắng thừa
# Ví dụ: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# JWT — bắt buộc đổi trên production (tối thiểu ~32 ký tự)
JWT_SECRET=your-long-random-secret-minimum-32-characters-long

# URL frontend (email, link) — khớp domain thật
FRONTEND_URL=https://yourdomain.com

# Gmail SMTP (tùy chọn) — không commit mật khẩu vào git
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# --- Render Static Site (build) — không dùng trong docker-compose
# PUBLIC_API_URL=https://your-api-service.onrender.com/api
